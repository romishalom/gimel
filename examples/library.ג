#כלול <קלטפלט>
#כלול <כללי>
#כלול <מחרוזת>

שלם השוואה(קבע ריק *א, קבע ריק *ב) {
    החזר *(קבע שלם *)א - *(קבע שלם *)ב;
}

שלם התחל(ריק) {
    שלם מספרים[] = { 5, 2, 9, 1, 7 };
    קבע ללס ארוך כמות = מדוד(מספרים) / מדוד(מספרים[0]);
    מיין(מספרים, כמות, מדוד(מספרים[0]), השוואה);
    עבור (ללס ארוך י = 0; י < כמות; י++) {
        הדפס("%d ", מספרים[י]);
    }
    הדפס("\n");
    הדפס("אורך: %zu\n", ספור("hello"));
    החזר 0;
}
