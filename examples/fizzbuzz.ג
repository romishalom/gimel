#כלול <קלטפלט>

שלם התחל(ריק) {
    עבור (שלם י = 1; י <= 15; י++) {
        בדוק (י % 15 == 0) {
            הדפס("פיזבז\n");
        } אחרת בדוק (י % 3 == 0) {
            הדפס("פיז\n");
        } אחרת בדוק (י % 5 == 0) {
            הדפס("בז\n");
        } אחרת {
            הדפס("%d\n", י);
        }
    }
    החזר 0;
}
